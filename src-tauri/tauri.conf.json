{
    "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName": "Ash",
    "version": "0.0.0",
    "identifier": "com.mg-studio.ash",
    "build": {
        "beforeDevCommand": "bun run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "bun run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "Ash",
                "width": 1100,
                "height": 700,
                "minWidth": 640,
                "minHeight": 400,
                "titleBarStyle": "Overlay",
                "hiddenTitle": true
            }
        ],
        "security": {
            "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
        }
    },
    "bundle": {
        "active": true,
        "targets": "app",
        "icon": ["icons/icon.icns"],
        "category": "DeveloperTool",
        "macOS": {
            "minimumSystemVersion": "12.0"
        }
    }
}
