{
  "name": "ash",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "package": "tauri build",
    "package:debug": "tauri build --debug --config src-tauri/tauri.dev.conf.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "smoke": "scripts/smoke.sh",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "rust:lint": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "rust:test": "cd src-tauri && cargo test",
    "verify": "bun run lint && bun run typecheck && bun test && bun run rust:fmt && bun run rust:lint && bun run rust:test",
    "verify:full": "bun run verify && bun run smoke"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.11.4",
    "@types/bun": "1.3.14",
    "eslint": "10.8.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0"
  }
}
